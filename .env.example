# Copy this file to .env.local and fill it in. Never commit .env.local.
# Without these, White Room runs as the open demo: no sign-in, nothing locked.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Set to true once the Google provider is enabled in Supabase. Shows the Google button.
NEXT_PUBLIC_GOOGLE_AUTH=false
# Optional. Used in sign-in email links. Defaults to the address the page is opened on.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (server-only, never NEXT_PUBLIC_). Gmail with an app password:
# Google Account > Security > 2-Step Verification on > App passwords.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
# Where new-query notifications go. Defaults to GMAIL_USER.
CONTACT_NOTIFY_TO=
